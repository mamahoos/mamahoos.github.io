---
import ThemeToggle from "./ThemeToggle.astro";
import DemoMark from "./DemoMark.astro";
import { site } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="site-header__mark" href="/">
    <span class="site-header__handle">{site.handle}</span>
    <DemoMark />
  </a>
  <nav aria-label="Primary">
    <ul>
      <li>
        <a
          class="cmd-link"
          href="/projects"
          aria-current={path.startsWith("/projects") ? "page" : undefined}
        >
          <span aria-hidden="true">[ </span>Projects<span aria-hidden="true"> ]</span>
        </a>
      </li>
      <li>
        <a
          class="cmd-link"
          href="/resume"
          aria-current={path.startsWith("/resume") ? "page" : undefined}
        >
          <span aria-hidden="true">[ </span>Resume<span aria-hidden="true"> ]</span>
        </a>
      </li>
      <li>
        <a class="cmd-link" href={site.github}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
  }

  .site-header__mark {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    row-gap: 0;
    min-height: 2.75rem;
    max-width: 100%;
    color: var(--color-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    text-decoration: none;
  }

  .site-header__handle {
    white-space: nowrap;
  }

  .site-header__mark:hover,
  .site-header__mark:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .site-header__mark:hover :global(.demo-mark),
  .site-header__mark:focus-visible :global(.demo-mark) {
    color: var(--color-accent);
  }

  .site-header__mark:hover :global(.demo-mark__paren),
  .site-header__mark:focus-visible :global(.demo-mark__paren) {
    color: var(--color-accent-hover);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    nav ul {
      gap: var(--space-2) var(--space-6);
    }
  }
</style>
