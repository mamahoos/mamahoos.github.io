---
const rays = [0, 45, 90, 135, 180, 225, 270, 315] as const;
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-pressed="false"
  aria-label="Color theme"
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--fill"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="6" fill="currentColor"></circle>
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    >
      {
        rays.map((deg) => (
          <line
            x1="12"
            y1="1.55"
            x2="12"
            y2="4.5"
            transform={`rotate(${deg} 12 12)`}
          />
        ))
      }
    </g>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--line"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <circle
      cx="12"
      cy="12"
      r="5.25"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
    >
    </circle>
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    >
      {
        rays.map((deg) => (
          <line
            x1="12"
            y1="1.55"
            x2="12"
            y2="4.5"
            transform={`rotate(${deg} 12 12)`}
          />
        ))
      }
    </g>
  </svg>
</button>

<script>
  const storageKey = "theme";
  const boundFlag = "__themeToggleBound";

  type ThemeRoot = Window & { __themeToggleBound?: boolean };

  function resolveTheme(): "light" | "dark" {
    const stored = document.documentElement.dataset.theme;
    if (stored === "light" || stored === "dark") {
      return stored;
    }
    return "light";
  }

  function syncToggle(button: HTMLButtonElement, theme: "light" | "dark") {
    const isDark = theme === "dark";
    button.setAttribute("aria-pressed", isDark ? "true" : "false");
    button.setAttribute(
      "aria-label",
      isDark ? "Color theme: dark" : "Color theme: light",
    );
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem(storageKey, theme);
  }

  const button = document.getElementById("theme-toggle");
  if (button instanceof HTMLButtonElement) {
    syncToggle(button, resolveTheme());

    const root = window as ThemeRoot;
    if (!root[boundFlag]) {
      root[boundFlag] = true;
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Node)) {
          return;
        }
        const toggle = (target instanceof Element ? target : target.parentElement)
          ?.closest("#theme-toggle");
        if (!(toggle instanceof HTMLButtonElement)) {
          return;
        }
        const next = resolveTheme() === "dark" ? "light" : "dark";
        applyTheme(next);
        syncToggle(toggle, next);
      });
    }
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-accent-hover);
  }

  .theme-toggle__icon {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    overflow: visible;
  }

  .theme-toggle__icon--line {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--fill {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-toggle__icon--line {
    display: block;
  }
</style>
