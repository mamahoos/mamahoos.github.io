---
import AsciiBox from "./AsciiBox.astro";

interface Props {
  href: string;
  title: string;
  meta: string;
  summary?: string;
}

const { href, title, meta, summary } = Astro.props;
---

<a class="project-card" href={href}>
  <AsciiBox nested>
    <span class="project-card__title">{title}</span>
    <span class="project-card__meta">{meta}</span>
    {summary ? <span class="project-card__summary">{summary}</span> : null}
  </AsciiBox>
</a>

<style>
  .project-card {
    display: block;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .project-card:hover :global(.ascii-box),
  .project-card:focus-visible :global(.ascii-box) {
    border-color: var(--color-accent);
  }

  .project-card:hover :global(.ascii-box__c),
  .project-card:focus-visible :global(.ascii-box__c) {
    color: var(--color-accent);
  }

  .project-card__title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 500;
  }

  .project-card__meta {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .project-card__summary {
    display: block;
    margin-top: var(--space-3);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: var(--text-small);
  }
</style>
