---
interface Props {
  href: string;
  index: number;
  title: string;
  meta: string;
  summary?: string;
}

const { href, index, title, meta, summary } = Astro.props;
const label = String(index).padStart(2, "0");
---

<a class="project-item" href={href}>
  <span class="project-item__index" aria-hidden="true">{label}</span>
  <span class="project-item__body">
    <span class="project-item__title">{title}</span>
    {summary ? <span class="project-item__summary">{summary}</span> : null}
    <span class="project-item__meta">{meta}</span>
  </span>
</a>

<style>
  .project-item {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: var(--space-4);
    min-height: 2.75rem;
    padding-block: var(--space-4);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .project-item__index {
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.5;
    transition: color var(--move);
  }

  .project-item__title {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 500;
    transition: color var(--move);
  }

  .project-item__summary {
    display: block;
    max-width: var(--measure);
    margin-top: var(--space-2);
    font-size: var(--text-small);
  }

  .project-item__meta {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .project-item:hover .project-item__index,
  .project-item:hover .project-item__title,
  .project-item:focus-visible .project-item__index,
  .project-item:focus-visible .project-item__title {
    color: var(--color-accent);
  }
</style>
