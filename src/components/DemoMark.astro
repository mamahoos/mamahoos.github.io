---
import { site } from "../data/site";
---

{
  site.demo && (
    <span class="demo-mark">
      <span class="demo-mark__paren" aria-hidden="true">(</span>demo<span class="demo-mark__paren" aria-hidden="true">)</span>
    </span>
  )
}

<style>
  .demo-mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: baseline;
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.3;
    white-space: nowrap;
    transition: color var(--move);
  }

  .demo-mark__paren {
    color: var(--color-line);
  }
</style>
