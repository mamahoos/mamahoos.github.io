---
import Layout from "../layouts/Layout.astro";
import AsciiSplit from "../components/AsciiSplit.astro";
import ProjectCard from "../components/ProjectCard.astro";
import DemoMark from "../components/DemoMark.astro";
import { site } from "../data/site";
import { getFeaturedProjects } from "../lib/projects";

const projects = await getFeaturedProjects();
---

<Layout
  title={`${site.name} · ${site.role}`}
  description={site.tagline}
>
  <p class="role">{site.role}</p>
  <h1>
    <span class="name">{site.name}</span>
    <DemoMark />
  </h1>
  <p class="tagline">{site.tagline}</p>
  <p class="actions">
    <a class="cmd-link" href="/projects">
      <span aria-hidden="true">[ </span>Projects<span aria-hidden="true"> ]</span>
    </a>
    <a class="cmd-link" href={site.github}>
      <span aria-hidden="true">[ </span>GitHub<span aria-hidden="true"> ]</span>
    </a>
  </p>

  <AsciiSplit />

  <h2>Selected work</h2>
  <ul class="project-list">
    {
      projects.map((project) => (
        <li>
          <ProjectCard
            href={`/projects/${project.id}`}
            index={project.data.order}
            title={project.data.title}
            meta={project.data.stack[0] ?? project.data.category}
          />
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .role {
    margin: 0;
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .name {
    flex: 1 1 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .name {
      flex: 0 1 auto;
    }
  }

  .tagline {
    max-width: var(--measure);
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-6) 0 0;
  }

  .actions .cmd-link {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .actions {
      gap: var(--space-4) var(--space-6);
    }
  }

  h2 {
    margin: 0 0 var(--space-2);
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-list li + li {
    border-top: 1px solid var(--color-line);
  }
</style>
