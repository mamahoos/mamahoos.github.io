---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import AsciiSplit from "../../components/AsciiSplit.astro";
import { getFeaturedProjects } from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getFeaturedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} · mamahoos`} description={project.data.summary}>
  <p class="kicker">
    <a class="cmd-link" href="/projects">
      <span aria-hidden="true">[ </span>Projects<span aria-hidden="true"> ]</span>
    </a>
  </p>
  <p class="type">{project.data.type.replace("-", " ")}</p>
  <p class="category">{project.data.category}</p>
  <h1>{project.data.title}</h1>
  <p class="summary">{project.data.summary}</p>
  <p class="stack">{project.data.stack.join(" · ")}</p>
  <p class="links">
    <a class="cmd-link" href={project.data.repo}>
      <span aria-hidden="true">[ </span>Source<span aria-hidden="true"> ]</span>
    </a>
    {
      project.data.relatedRepos.map((related) => (
        <a class="cmd-link" href={related.url}>
          <span aria-hidden="true">[ </span>{related.label}<span aria-hidden="true"> ]</span>
        </a>
      ))
    }
  </p>
  <AsciiSplit />
  <div class="body">
    <Content />
  </div>
</Layout>

<style>
  .kicker {
    margin: 0 0 var(--space-4);
  }

  .type,
  .category,
  .stack {
    margin: 0;
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .type {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .summary {
    max-width: var(--measure);
    margin: 0;
  }

  .stack {
    margin-top: var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 40rem) {
    .links {
      gap: var(--space-2) var(--space-6);
    }
  }

  .body {
    max-width: 100%;
    overflow-x: auto;
  }

  .body :global(h2),
  .body :global(h3) {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .body :global(h2) {
    font-size: 1.125rem;
  }

  .body :global(h3) {
    font-size: var(--text-body);
  }

  .body :global(h2:not(:first-child)),
  .body :global(h3) {
    margin-top: var(--space-8);
  }

  .body :global(h2 + h3) {
    margin-top: var(--space-4);
  }

  .body :global(p),
  .body :global(li) {
    max-width: var(--measure);
  }

  .body :global(p) {
    margin: 0 0 var(--space-4);
  }

  .body :global(ul),
  .body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: var(--space-2);
  }

  .body :global(blockquote) {
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-line);
    color: var(--color-muted-foreground);
  }

  .body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .body :global(pre) {
    overflow-x: auto;
    max-width: 100%;
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .body :global(pre code) {
    font-size: inherit;
  }

  .body :global(table) {
    width: max-content;
    max-width: 100%;
    margin: 0 0 var(--space-4);
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .body :global(th),
  .body :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-line);
    text-align: start;
    vertical-align: top;
  }

  .body :global(th) {
    color: var(--color-muted-foreground);
    font-weight: 500;
  }

  .body :global(hr) {
    margin: var(--space-8) 0;
    border: 0;
    border-top: 1px solid var(--color-line);
  }

  .body :global(strong) {
    font-weight: 500;
  }
</style>
