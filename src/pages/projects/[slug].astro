---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import AsciiSplit from "../../components/AsciiSplit.astro";
import { getFeaturedProjects } from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getFeaturedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} · mamahoos`} description={project.data.summary}>
  <p class="kicker">
    <a class="cmd-link" href="/projects">
      <span aria-hidden="true">[ </span>Projects<span aria-hidden="true"> ]</span>
    </a>
  </p>
  <p class="category">{project.data.category}</p>
  <h1>{project.data.title}</h1>
  <p class="summary">{project.data.summary}</p>
  <p class="stack">{project.data.stack.join(" · ")}</p>
  <p class="links">
    <a class="cmd-link" href={project.data.repo}>
      <span aria-hidden="true">[ </span>Source<span aria-hidden="true"> ]</span>
    </a>
    {
      project.data.relatedRepos.map((related) => (
        <a class="cmd-link" href={related.url}>
          <span aria-hidden="true">[ </span>{related.label}<span aria-hidden="true"> ]</span>
        </a>
      ))
    }
  </p>
  <AsciiSplit />
  <div class="body">
    <Content />
  </div>
</Layout>

<style>
  .kicker {
    margin: 0 0 var(--space-4);
  }

  .category,
  .stack {
    margin: 0;
    color: var(--color-muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .summary {
    max-width: var(--measure);
    margin: 0;
  }

  .stack {
    margin-top: var(--space-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-4) 0 0;
  }

  .body :global(h2) {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .body :global(h2:not(:first-child)) {
    margin-top: var(--space-8);
  }

  .body :global(p) {
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }

  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
